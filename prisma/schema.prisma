// EduShelf Prisma schema.
// Application models are intentionally deferred until Module 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           Int       @id @default(autoincrement())
  firstName    String
  lastName     String
  passwordHash String?
  email        String?   @unique
  phoneNumber  String?   @unique
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  reviews      Review[]
  cart         Cart?
  Wishlist     Wishlist?
  Order        Order[]
  refreshSessions RefreshSession[]
  refreshSessionFamilies RefreshSessionFamily[]
}

enum BookFormat {
  PHYSICAL
  EBOOK
}

model Book {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  isbn          String         @unique
  author        String
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id])
  levelId       Int
  level         Level          @relation(fields: [levelId], references: [id])
  price         Decimal
  stock         Int            @default(0)
  isAvailable   Boolean        @default(true)
  format        BookFormat     @default(PHYSICAL)
  images        BookImage[]
  reviews       Review[]
  CartItem      CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
}

model BookImage {
  id       Int    @id @default(autoincrement())
  imageUrl String
  bookId   Int
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  books       Book[]
}

model Level {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  books       Book[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id       Int  @id @default(autoincrement())
  quantity Int  @default(1)
  cartId   Int
  cart     Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  bookId   Int
  book     Book @relation(fields: [bookId], references: [id])

  @@unique([cartId, bookId])
}

model Wishlist {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     WishlistItem[]
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  Wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  bookId     Int
  book       Book     @relation(fields: [bookId], references: [id])

  @@unique([wishlistId, bookId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
  payment     Payment?
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  unitPrice Decimal
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId    Int
  book      Book    @relation(fields: [bookId], references: [id])

  @@unique([orderId, bookId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int           @unique
  order          Order         @relation(fields: [orderId], references: [id])
  amount         Decimal
  transactionRef String?
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
}


model RefreshSession {
  id        String @id @default(uuid()) @db.Uuid
  familyId  String @db.Uuid

  userId    Int
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])

  family RefreshSessionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
}
model RefreshSessionFamily {
  id String @id @default(uuid()) @db.Uuid
  userId    Int
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  sessions RefreshSession[]
}